# Experiment 4 Task 3: 0-E counter with BDF top level
# Board/device: DE0-CV, Cyclone V 5CEBA4F23C7

set_global_assignment -name FAMILY "Cyclone III"
set_global_assignment -name DEVICE Auto
set_global_assignment -name TOP_LEVEL_ENTITY experiment_four_task3
set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "2.5 V"

set_global_assignment -name BDF_FILE experiment_four_task3.bdf
set_global_assignment -name VHDL_FILE exa4_3_counter_0e.vhd

# CLOCK_50 -> clk, KEY0 -> active-low rst
set_location_assignment PIN_M9 -to clk
set_location_assignment PIN_U7 -to rst

# DOUT[3..0] -> LEDR3..LEDR0, COUT -> LEDR4
set_location_assignment PIN_Y3 -to DOUT[3]
set_location_assignment PIN_W2 -to DOUT[2]
set_location_assignment PIN_AA1 -to DOUT[1]
set_location_assignment PIN_AA2 -to DOUT[0]
set_location_assignment PIN_N2 -to COUT

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
