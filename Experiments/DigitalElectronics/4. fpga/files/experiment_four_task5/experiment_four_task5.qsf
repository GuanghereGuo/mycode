# Quartus pin assignments for experiment_four
# Target board/device: Cyclone V 5CEBA4F23C7
# Function:
#   50 MHz clock input -> two divider modules
#   exa4_4_1 output = 1 Hz  -> LED2
#   exa4_4_2 output = 10 Hz -> LED1

# Device
set_global_assignment -name FAMILY "Cyclone III LS"
set_global_assignment -name DEVICE Auto

# Top-level entity from experiment_four.bdf
set_global_assignment -name TOP_LEVEL_ENTITY experiment_four_task5

# Input: 50 MHz onboard clock

# Output: 1 Hz signal, from exa4_4_1, connect to LED2 / LEDR2

# Output: 10 Hz signal, from exa4_4_2, connect to LED1 / LEDR1

set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name BDF_FILE experiment_four_task5.bdf
set_global_assignment -name BDF_FILE Block1.bdf
set_global_assignment -name VHDL_FILE exa4_4_2.vhd
set_global_assignment -name VHDL_FILE exa4_4_1.vhd
set_global_assignment -name VHDL_FILE exa4_3_2.vhd
set_global_assignment -name VHDL_FILE exa4_2_2.vhd
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name VHDL_FILE exa4_auto_1hz_10hz.vhd
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "2.5 V"
set_location_assignment PIN_M9 -to pin_name4
set_location_assignment PIN_U13 -to pin_name5
set_location_assignment PIN_AA22 -to SG_OUT[6]
set_location_assignment PIN_Y21 -to SG_OUT[5]
set_location_assignment PIN_Y22 -to SG_OUT[4]
set_location_assignment PIN_W21 -to SG_OUT[3]
set_location_assignment PIN_W22 -to SG_OUT[2]
set_location_assignment PIN_V21 -to SG_OUT[1]
set_location_assignment PIN_U21 -to SG_OUT[0]
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
set_global_assignment -name SIMULATION_MODE FUNCTIONAL
set_global_assignment -name VECTOR_WAVEFORM_FILE Waveform.vwf
set_global_assignment -name INCREMENTAL_VECTOR_INPUT_SOURCE "D:/TmpCode/fpga/experiment_four_task5/Waveform.vwf"